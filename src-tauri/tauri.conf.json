{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexora",
  "version": "0.1.0",
  "identifier": "net.ny4n.nexora",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter ui dev",
    "beforeBuildCommand": "pnpm --filter ui build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Nexora",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "createUpdaterArtifacts": true,
    "licenseFile": "../LICENSE",
    "copyright": "Copyright 2026 Nexora Launcher contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0NENEMzQyODVCREQxNjAKUldSZzBiMkZRdE5NaENsZDI1MDhsTmc4QWxlTFdDMm5hL3VSbDZpVk41dlJ1TWl4WFFpY2hseGoK",
      "endpoints": [
        "https://github.com/Nek0cha/Nexora-Launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
