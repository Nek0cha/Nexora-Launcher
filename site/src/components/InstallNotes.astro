---
import IconApple from "~icons/ph/apple-logo";
import IconLinux from "~icons/ph/linux-logo";
import IconWindows from "~icons/ph/windows-logo";
import type { Lang } from "../i18n";
import { dict } from "../i18n";

const { lang } = Astro.props as { lang: Lang };
const t = dict(lang);
const icons = [IconWindows, IconApple, IconLinux];
---

<section class="border-t border-line bg-surface-1">
  <div class="mx-auto grid max-w-[1240px] gap-10 px-5 py-20 md:px-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
    <div class="flex flex-col gap-4">
      <h2 class="font-display text-[32px] leading-tight font-semibold tracking-[-0.02em] text-text-strong [:lang(ja)_&]:text-[28px] [:lang(ja)_&]:tracking-[0.02em]">
        {t.install.title}
      </h2>
      <p class="text-text-muted">{t.install.lead}</p>
    </div>
    <div class="flex flex-col gap-8">
      <ul class="grid gap-x-10 gap-y-6 md:grid-cols-3">
        {
          t.install.items.map((item, i) => {
            const Icon = icons[i]!;
            return (
              <li class="flex flex-col gap-2">
                <h3 class="flex items-center gap-2 font-semibold text-text-strong">
                  <Icon aria-hidden="true" class="size-5 text-text-muted" />
                  <span>{item.os}</span>
                </h3>
                <p class="text-[15px] text-text-muted">{item.body}</p>
              </li>
            );
          })
        }
      </ul>
      <p class="text-[15px] text-text-muted">{t.install.updates}</p>
    </div>
  </div>
</section>
